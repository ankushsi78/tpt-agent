<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bayfin.optionlookup</string>
  <!-- Invoke Python directly (like the other bots). A shell-script wrapper in
       ~/Documents is blocked by macOS when launched by a background LaunchAgent
       (exit 126, "Operation not permitted"). -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
    <string>/Users/ankushsinghal/Documents/Trading/option_lookup_job.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ankushsinghal/Documents/Trading</string>
  <!-- Every weekday (Mon–Fri) at 7:05 AM local time (PT on this Mac). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/ankushsinghal/Documents/Trading/logs/option_lookup.out</string>
  <key>StandardErrorPath</key><string>/Users/ankushsinghal/Documents/Trading/logs/option_lookup.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
